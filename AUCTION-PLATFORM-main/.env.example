# Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auction_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate high-entropy keys for production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_at_least_32_chars_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Session & Cookie Secrets
COOKIE_SECRET=your_cookie_secret_key_at_least_32_chars

# Payment Configuration (Paystack / Stripe abstraction)
PAYMENT_PROVIDER=MOCK
PAYMENT_SECRET_KEY=sk_test_placeholder
PAYMENT_WEBHOOK_SECRET=whsec_placeholder

# Storage Configuration
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# SMTP / Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder
SMTP_PASS=placeholder
EMAIL_FROM="AuctionX Platform <noreply@auctionx.com>"
