# AuctionX Backend Environment Variables Example
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_HOST.supabase.co:5432/postgres?schema=public&sslmode=require"

# Redis Cache & WebSockets Pub/Sub (Upstash Redis / Redis Cloud)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS=true

# Security Secrets (Generate using openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_min_32_chars
COOKIE_SECRET=your_super_secret_cookie_signing_key_min_32_chars
ARGON2_SECRET=your_argon2_pepper_secret_key
